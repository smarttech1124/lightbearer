# ============================================================
#  Light Bearers Picnic Portal — Environment Configuration
#  Copy this file to ".env" and fill in real values.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000
# Public base URL used in emails, QR codes and check-in links.
# In production set this to your HTTPS domain, e.g. https://picnic.lightbearers.org
PUBLIC_BASE_URL=http://localhost:4000

# --- Database (PostgreSQL via Prisma) ---
# A Postgres connection string. Use Neon / Supabase / Vercel Postgres / Render, etc.
# Example: postgresql://user:pass@host:5432/lightbearers?sslmode=require
# For a quick local SQLite smoke test you may instead use: file:./prisma/dev.db
DATABASE_URL=

# Where uploaded receipts are stored on disk. Leave blank for ./uploads. On a host
# with an ephemeral filesystem, point this at a mounted persistent volume,
# e.g. UPLOADS_DIR=/var/data/uploads
UPLOADS_DIR=

# --- Security secrets (CHANGE THESE IN PRODUCTION) ---
# Generate strong random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SESSION_HOURS=12

# --- First / bootstrap admin account (created automatically on first run) ---
# After first login you can change the password from the dashboard.
ADMIN_EMAIL=admin@lightbearers.org
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Lead Administrator

# --- Event / pricing configuration ---
EVENT_NAME=Light Bearers Picnic Hangout
EARLY_BIRD_LIMIT=20
EARLY_BIRD_FEE=1500
REGULAR_FEE=2000
CURRENCY=NGN
CURRENCY_SYMBOL=₦

# --- Bank payment details shown to participants ---
# These are the INITIAL defaults. A superadmin can change them anytime from the
# admin portal (Settings → Bank details & notifications) without editing this file.
BANK_NAME=Guaranty Trust Bank (GTBank)
BANK_ACCOUNT_NAME=Light Bearers Picnic
BANK_ACCOUNT_NUMBER=0123456789

# --- Group configuration (comma separated) ---
GROUPS=Lighters,Bearers,Anchors,Trailblazers

# --- Email (Resend) ---
# Preferred provider: Resend (https://resend.com). Create an API key and paste it here.
# Leave RESEND_API_KEY and SMTP_HOST blank to run in "console" mode (emails are
# logged and recorded, but not actually delivered — handy for local testing).
RESEND_API_KEY=
# The "From" address. For Resend the sending domain must be verified in your Resend
# account; use onboarding@resend.dev while testing.
MAIL_FROM="Light Bearers Picnic <onboarding@resend.dev>"

# --- Admin notification email ---
# Receives "receipt uploaded — please verify" alerts when a participant uploads a
# receipt. Defaults to ADMIN_EMAIL. Can also be set from the admin portal (Settings).
ADMIN_NOTIFY_EMAIL=

# --- Uploads ---
MAX_UPLOAD_MB=8
